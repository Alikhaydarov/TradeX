{
  "name": "tradoxy",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @tradoxy/database generate",
    "db:migrate": "pnpm --filter @tradoxy/database migrate",
    "db:studio": "pnpm --filter @tradoxy/database studio"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}

